# Server
PORT=3000
BASE_URL=https://YOUR_PUBLIC_URL.ngrok-free.app

# Twilio credentials (TODO: fill from Twilio Console)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_VOICE=Polly.Joanna

# Security token for /api/calls/outbound
OUTBOUND_API_TOKEN=change-me-long-random-token

# Independent secret required on Twilio media-stream WebSocket upgrades (32+ chars)
MEDIA_STREAM_TOKEN=change-me-independent-long-random-media-token

# Comma-separated E.164 numbers allowed for outbound calling
OUTBOUND_ALLOWLIST=+31600000000,+31611111111

# Voice provider. Keep ElevenLabs as the rollback-safe default.
VOICE_PROVIDER=elevenlabs

# ElevenLabs Conversational AI
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_AGENT_ID=your_elevenlabs_agent_id

# GPT-Live side-by-side pilot. Calls must explicitly send provider="gpt-live".
# VOICE_PROVIDER is informational only; omitted provider always uses ElevenLabs.
# Set the kill switch false to reject new and already-queued GPT-Live sessions.
GPT_LIVE_PILOT_ENABLED=false
OPENAI_API_KEY=your_openai_api_key
GPT_LIVE_MODEL=gpt-live-1
GPT_LIVE_BACKEND_MODEL=gpt-5.6-luna
GPT_LIVE_VOICE=willow

# Auto-end guards for GPT-Live calls (prevents the line sitting open with dead
# air if the model keeps the session open). Inactivity = no transcript activity.
GPT_LIVE_INACTIVITY_MS=15000
GPT_LIVE_MAX_CALL_MS=600000

# Smart IVR mode is opt-in per outbound request with `smartIvr: true` and only
# works with provider="gpt-live". Each model-selected digit rebuilds the Twilio
# media stream; cap handoffs to prevent loops.
SMART_IVR_MAX_HOPS=12
